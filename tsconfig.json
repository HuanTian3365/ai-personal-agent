{
  "files": [],
  "references": [
    {
      "path": "./tsconfig.node.json"
    },
    {
      "path": "./tsconfig.web.json"
    }
  ],
  "compilerOptions": {
    "paths": {
      "@core": [
        "./src/core/export.ts"
      ],
      "@core/*": [
        "./src/core/*"
      ],
      "@main": [
        "./src/main/export.ts"
      ],
      "@main/*": [
        "./src/main/*"
      ],
      "@renderer/*": [
        "./src/renderer/src/*"
      ],
      "@shared/*": [
        "./src/shared/*"
      ]
    }
  }
}